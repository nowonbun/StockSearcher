CREATE TABLE IF NOT EXISTS STOCK_LIST (
    code varchar(10),
    `name` varchar(200),
    stocktype varchar(200),
    industry33code varchar(200),
    industry33type varchar(200),
    industry17code varchar(200),
    industry17type varchar(200),
    scalecode varchar(200),
    scaletype varchar(200),
    create_date datetime,
    update_date datetime,

    PRIMARY KEY (code)
);

CREATE TABLE IF NOT EXISTS STOCK_DATA (
    code varchar(10),
    `date` date,
    `Open` DECIMAL(16,2), 
    High DECIMAL(16,2),
    Low DECIMAL(16,2),
    `Close` DECIMAL(16,2),
    Volume DECIMAL(16,2),
    TransAmnt DECIMAL(16,2),
    5MvAvg DECIMAL(16,2),
    20MvAvg DECIMAL(16,2),
    50MvAvg DECIMAL(16,2),
    60MvAvg DECIMAL(16,2),
    120MvAvg DECIMAL(16,2),
    240MvAvg DECIMAL(16,2),
    upperband60_1 DECIMAL(16,2),
    lowerband60_1 DECIMAL(16,2),
    lowerband60_3 DECIMAL(16,2),
    create_date datetime,
    update_date datetime,
    
    PRIMARY KEY (code, `date`),
    FOREIGN KEY (code) REFERENCES STOCK_LIST(code)
);

CREATE TABLE IF NOT EXISTS STOCK_DATA_WEEK (
    
    code varchar(10),
    `date` date,
    `Open` DECIMAL(16,2), 
    High DECIMAL(16,2),
    Low DECIMAL(16,2),
    `Close` DECIMAL(16,2),
    Volume DECIMAL(16,2),
    TransAmnt DECIMAL(16,2),
    5MvAvg DECIMAL(16,2),
    20MvAvg DECIMAL(16,2),
    50MvAvg DECIMAL(16,2),
    60MvAvg DECIMAL(16,2),
    120MvAvg DECIMAL(16,2),
    240MvAvg DECIMAL(16,2),
    upperband60_1 DECIMAL(16,2),
    lowerband60_1 DECIMAL(16,2),
    lowerband60_3 DECIMAL(16,2),
    create_date datetime,
    update_date datetime,
    
    PRIMARY KEY (code, `date`),
    FOREIGN KEY (code) REFERENCES STOCK_LIST(code)
);
```