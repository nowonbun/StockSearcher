# README.md

## Environment Setup

Make sure you have the following versions installed:

- **Python Version:** 3.10.10
- https://www.python.org/downloads/release/python-31010/

## Package Installation

```bash
pip install pandas==2.1.4
pip install numpy==1.26.3
pip install requests==2.31.0
pip install finance-datareader==0.9.66
pip install beautifulsoup4==4.12.2
pip install plotly==5.18.0
pip install logging==0.4.9.6

pip install mysqlclient=2.2.1
pip install mysql-connector-python
pip install selenium webdriver-manager

pip install openpyxl
pip install xlrd
pip install pyyaml
pip install yahoo-finance-api2
```

## Database Operations
```sql
-- Creating Database
CREATE DATABASE stock_dataset;
USE stock_dataset;

-- Dropping Tables (if exist)
DROP TABLE IF EXISTS STOCK_DATA;
DROP TABLE IF EXISTS STOCK_LIST;
DROP VIEW IF EXISTS stock_top_350;
DROP VIEW IF EXISTS kospi_top_200;
DROP VIEW IF EXISTS kosdaq_top_100;

-- Creating Tables (한국)
CREATE TABLE STOCK_LIST (
    code varchar(10),
    name varchar(200),
    market varchar(200),
    order_no int,
    create_date datetime,
    update_date datetime,
    
    PRIMARY KEY (code)
);

