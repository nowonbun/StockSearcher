# syntax=docker/dockerfile:1.4
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir mcp mysql-connector-python

COPY test/mariadb_mcp_server.py /app/mariadb_mcp_server.py
COPY config.ini /app/config.ini

CMD ["python", "/app/mariadb_mcp_server.py"]
